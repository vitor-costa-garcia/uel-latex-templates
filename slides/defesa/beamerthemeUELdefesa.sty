% Beamer theme for thesis (TCC) defenses at the Universidade Estadual de
% Londrina (UEL), with the Departamento de Computação (DC) logo. Light, quiet
% layout with a progress bar to keep track of the time. Visual identity follows
% the "Manual de identidade visual da UEL".
%
% Options:
%   fontpath=<dir>    where the bundled Faustina .ttf files live (default fonts/)
%   logopath=<dir>    where the logo PDFs live (default img/logos/pdf/)
%   nodc              leave out the DC logo (plain UEL slides)
%   noprogress        no progress bar above the footer
%
% Title slide data: \title, \subtitle, \author, \date plus
%   \orientador{Prof. Dr. ...}  \banca{Prof. Dr. ...\\Profa. Dra. ...}
%   \tipotrabalho{Trabalho de Conclusão de Curso}  \curso{Ciência da Computação}
%   \local{Londrina}
% Closing slide: \obrigado[contact line]
\ProvidesPackage{beamerthemeUELdefesa}[2026/10/21 UEL defense beamer theme]
\mode<presentation>

\RequirePackage{tikz}
\usetikzlibrary{calc}

\newif\ifuel@dc \uel@dctrue
\newif\ifuel@progress \uel@progresstrue
\def\uel@fontpath{fonts/}
\def\uel@logopath{img/logos/pdf/}
\DeclareOptionBeamer{fontpath}{\def\uel@fontpath{#1}}
\DeclareOptionBeamer{logopath}{\def\uel@logopath{#1}}
\DeclareOptionBeamer{nodc}{\uel@dcfalse}
\DeclareOptionBeamer{noprogress}{\uel@progressfalse}
\ProcessOptionsBeamer

\usecolortheme{UELdefesa}
\usefonttheme{UELdefesa}

% --- Defense data ---------------------------------------------------------------
\def\uel@orientador{}
\def\uel@banca{}
\def\uel@tipotrabalho{Trabalho de Conclusão de Curso}
\def\uel@curso{}
\def\uel@local{Londrina}
\newcommand*\orientador[1]{\def\uel@orientador{#1}}
\newcommand*\banca[1]{\def\uel@banca{#1}}
\newcommand*\tipotrabalho[1]{\def\uel@tipotrabalho{#1}}
\newcommand*\curso[1]{\def\uel@curso{#1}}
\newcommand*\local[1]{\def\uel@local{#1}}

% --- Logos ----------------------------------------------------------------
\def\uel@logodir{}
\@for\uel@dir:=\uel@logopath,img/logos/pdf/,../img/logos/pdf/,../../img/logos/pdf/\do{%
  \ifx\uel@logodir\@empty
    \IfFileExists{\uel@dir simbolo-cor.pdf}{\edef\uel@logodir{\uel@dir}}{}%
  \fi}
\ifx\uel@logodir\@empty
  \PackageError{beamerthemeUELdefesa}{Logo files not found}
    {Copy img/logos/pdf/ next to your document or set the `logopath' option.}
\fi
\newcommand*\uel@logo[2][]{\includegraphics[#1]{\uel@logodir #2}}

% --- Layout ----------------------------------------------------------------
\newlength\uel@margin
\setlength\uel@margin{1.4cm}
\setbeamersize{text margin left=\uel@margin,text margin right=1cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}

% A narrow green stripe at the left edge of every slide.
\setbeamertemplate{background canvas}{%
  \color{uelgreen}\rule{.22cm}{\paperheight}\hfill}

\setbeamertemplate{itemize item}{\rule[.1ex]{.6ex}{.6ex}}
\setbeamertemplate{itemize subitem}{\rule[.1ex]{.45ex}{.45ex}}
\setbeamertemplate{itemize subsubitem}{\rule[.1ex]{.35ex}{.35ex}}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertenumlabel.\insertsubenumlabel}
\setbeamertemplate{caption label separator}{: }
\setbeamertemplate{bibliography item}{}
\setbeamertemplate{blocks}[default]

% Frame title: Faustina, with a short green accent rule beneath it.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vbox{%
    \vskip1.6ex
    \hbox to\textwidth{%
      \begin{minipage}[b][.8cm][b]{\textwidth}
        \raggedright
        \usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle\par
        \ifx\insertframesubtitle\@empty\else
          {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
        \fi
      \end{minipage}}%
    \vskip.9ex
    \hbox{\color{uelgreen}\rule{2.2cm}{1.2pt}}}%
}

% Footer: progress line, then symbol and author | section | page.
\newcommand*\uel@progressbar{%
  \ifuel@progress
    \hbox to\paperwidth{%
      {\color{uelgreen}\rule{\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax}{1.4pt}}%
      {\color{black!12}\leaders\hrule height1.4pt\hfill}}%
  \fi}
% \textwidth is the full page width inside the footline, so use its own length.
\newlength\uel@footw
\setbeamertemplate{footline}{%
  \setlength\uel@footw{\dimexpr\paperwidth-\uel@margin-1cm\relax}%
  \vbox{%
    \uel@progressbar
    \vskip.9ex
    \hbox to\paperwidth{%
      \hspace*{\uel@margin}%
      \hbox to\uel@footw{%
        \hbox to.4\uel@footw{\uel@logo[height=.42cm]{simbolo-cor}\hspace{.2cm}%
          \usebeamerfont{footline}\usebeamercolor[fg]{footline}\insertshortauthor\hss}%
        \hbox to.3\uel@footw{\hss\usebeamerfont{footline}\usebeamercolor[fg]{footline}\insertsection\hss}%
        \hbox to.3\uel@footw{\hss\usebeamerfont{footline}\usebeamercolor[fg]{footline}%
          \insertframenumber\,/\,\inserttotalframenumber}}%
      \hss}%
    \vskip1.1ex}%
}

% --- Title slide (\maketitle makes a plain frame, without the footer) ---------
\renewcommand\maketitle{%
  \begin{frame}[plain,noframenumbering]
    \titlepage
  \end{frame}}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    % a wider stripe than on the other slides
    \fill[uelgreen] (current page.north west) rectangle
      ([xshift=.9cm]current page.south west);
    \node[anchor=north west,inner sep=0] at
      ([xshift=1.8cm,yshift=-.8cm]current page.north west)
      {\uel@logo[height=.85cm]{horizontal-cor}};
    \ifuel@dc
      \node[anchor=north east,inner sep=0] at
        ([xshift=-1cm,yshift=-.6cm]current page.north east)
        {\uel@logo[height=1.25cm]{dc-cor}};
    \fi
    \node[anchor=north west,inner sep=0,text width=.78\paperwidth,align=left] at
      ([xshift=1.8cm,yshift=-.3\paperheight]current page.north west) {%
      {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
      \ifx\insertsubtitle\@empty\else
        \vskip1ex
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
      \fi
      \vskip1.2ex
      {\color{uelgreen}\rule{2.2cm}{1.2pt}}%
    };
    \node[anchor=south west,inner sep=0,text width=.5\paperwidth,align=left] at
      ([xshift=1.8cm,yshift=.9cm]current page.south west) {%
      {\usebeamerfont{author}\color{uelgreen}\insertauthor\par}%
      \usebeamerfont{info}\color{uelblack}%
      \ifx\uel@orientador\@empty\else\vskip.8ex
        \textbf{Orientador:} \uel@orientador\par\fi
      \ifx\uel@banca\@empty\else\vskip.5ex
        \textbf{Banca:} \uel@banca\par\fi
    };
    \node[anchor=south east,inner sep=0,text width=.28\paperwidth,align=right] at
      ([xshift=-1cm,yshift=.9cm]current page.south east) {%
      \usebeamerfont{info}\color{dcgreydark}%
      \ifx\uel@curso\@empty\else\uel@tipotrabalho\\ \uel@curso\par\vskip.5ex\fi
      \uel@local, \insertdate\par
    };
  \end{tikzpicture}%
}

% --- Closing slide -----------------------------------------------------------------
% \obrigado[contact line]
\newcommand*\obrigado[1][]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[uelgreen] (current page.north west) rectangle
        ([xshift=.9cm]current page.south west);
      \node[anchor=west,inner sep=0,text width=.7\paperwidth,align=left] at
        ([xshift=1.8cm,yshift=.5cm]current page.west) {%
        {\usebeamerfont{thanks}\usebeamercolor[fg]{thanks}Obrigado!\par}%
        \vskip1ex{\color{uelgreen}\rule{2.2cm}{1.2pt}}%
        \ifx\relax#1\relax\else\vskip2ex{\usebeamerfont{info}\color{dcgreydark}#1\par}\fi
      };
      \node[anchor=south east,inner sep=0] at
        ([xshift=-1cm,yshift=.7cm]current page.south east) {%
        \uel@logo[height=.85cm]{horizontal-cor}%
        \ifuel@dc\hspace{.5cm}\uel@logo[height=1.25cm]{dc-cor}\fi};
    \end{tikzpicture}
  \end{frame}}

% --- Table of contents -------------------------------------------------------------
\setbeamertemplate{section in toc}{%
  \leavevmode\color{uelgreen}\bfseries\inserttocsectionnumber.\ %
  \color{uelblack}\inserttocsection\par}
\setbeamertemplate{subsection in toc}{%
  \leavevmode\leftskip=1.4em\color{dcgreydark}\small\inserttocsubsection\par}

\mode<all>
