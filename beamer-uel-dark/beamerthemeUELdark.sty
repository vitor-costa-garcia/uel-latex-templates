% Dark beamer theme for the Universidade Estadual de Londrina (UEL), with the
% Departamento de Computação (DC) logo. Deep emerald background derived from
% Verde UEL, with the negative (white) logo versions from the identity manual.
% The DC logo has no negative version, so it sits on a small white plate.
%
% Options:
%   fontpath=<dir>    where the bundled Faustina .ttf files live (default fonts/)
%   logopath=<dir>    where the logo PDFs live (default img/logos/pdf/)
%   nodc              leave out the DC logo (plain UEL slides)
%   nowatermark       no faint symbol on the title and section slides
%   nosectionpage     no automatic divider slide at each \section
\ProvidesPackage{beamerthemeUELdark}[2026/10/21 UEL dark beamer theme]
\mode<presentation>

\RequirePackage{tikz}
\usetikzlibrary{calc}

\newif\ifuel@dc \uel@dctrue
\newif\ifuel@watermark \uel@watermarktrue
\newif\ifuel@sectionpage \uel@sectionpagetrue
\def\uel@fontpath{fonts/}
\def\uel@logopath{img/logos/pdf/}
\DeclareOptionBeamer{fontpath}{\def\uel@fontpath{#1}}
\DeclareOptionBeamer{logopath}{\def\uel@logopath{#1}}
\DeclareOptionBeamer{nodc}{\uel@dcfalse}
\DeclareOptionBeamer{nowatermark}{\uel@watermarkfalse}
\DeclareOptionBeamer{nosectionpage}{\uel@sectionpagefalse}
\ProcessOptionsBeamer

\usecolortheme{UELdark}
\usefonttheme{UELdark}

% --- Logos ----------------------------------------------------------------
\def\uel@logodir{}
\@for\uel@dir:=\uel@logopath,img/logos/pdf/,../img/logos/pdf/\do{%
  \ifx\uel@logodir\@empty
    \IfFileExists{\uel@dir simbolo-branco.pdf}{\edef\uel@logodir{\uel@dir}}{}%
  \fi}
\ifx\uel@logodir\@empty
  \PackageError{beamerthemeUELdark}{Logo files not found}
    {Copy img/logos/pdf/ next to your document or set the `logopath' option.}
\fi
\newcommand*\uel@logo[2][]{\includegraphics[#1]{\uel@logodir #2}}
% DC logo on a white plate (it has no negative version): \uel@dclogo{<height>}
\newcommand*\uel@dclogo[1]{%
  \begingroup\setlength\fboxsep{.12cm}\colorbox{white}{\uel@logo[height=#1]{dc-cor}}\endgroup}

% --- Layout ----------------------------------------------------------------
\newlength\uel@margin
\setlength\uel@margin{.9cm}
\setbeamersize{text margin left=\uel@margin,text margin right=\uel@margin}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}

\setbeamertemplate{itemize item}{\rule[.1ex]{.6ex}{.6ex}}
\setbeamertemplate{itemize subitem}{\rule[.1ex]{.45ex}{.45ex}}
\setbeamertemplate{itemize subsubitem}{\rule[.1ex]{.35ex}{.35ex}}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertenumlabel.\insertsubenumlabel}
\setbeamertemplate{caption label separator}{: }
\setbeamertemplate{bibliography item}{}
\setbeamertemplate{blocks}[default]

% Frame title: Faustina in white, white symbol on the right, green rule.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vbox{%
    \vskip1ex
    \hbox to\textwidth{%
      \begin{minipage}[c][.8cm][c]{\dimexpr\textwidth-1.2cm\relax}
        \raggedright
        \usebeamercolor[fg]{frametitle}\usebeamerfont{frametitle}\insertframetitle\par
        \ifx\insertframesubtitle\@empty\else
          {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
        \fi
      \end{minipage}\hfil
      \uel@logo[height=.8cm]{simbolo-branco}}%
    \vskip.6ex
    \hbox to\textwidth{\color{uelshape}\rule{\textwidth}{.8pt}}}%
}

% Footer: a hairline, then author | short title | page. \textwidth is the full
% page width inside the footline, so it gets its own length.
\newlength\uel@footw
\setbeamertemplate{footline}{%
  \setlength\uel@footw{\dimexpr\paperwidth-2\uel@margin\relax}%
  \vbox{%
    \vskip.4ex
    \hbox to\paperwidth{\hspace*{\uel@margin}\color{uelline}\rule{\uel@footw}{.4pt}\hss}%
    \vskip.9ex
    \hbox to\paperwidth{%
      \hspace*{\uel@margin}%
      \hbox to\uel@footw{%
        \hbox to.3\uel@footw{\usebeamerfont{footline}\usebeamercolor[fg]{footline}\insertshortauthor\hss}%
        \hbox to.4\uel@footw{\hss\usebeamerfont{footline}\usebeamercolor[fg]{footline}\insertshorttitle\hss}%
        \hbox to.3\uel@footw{\hss\usebeamerfont{footline}\usebeamercolor[fg]{footline}%
          \insertframenumber\,/\,\inserttotalframenumber}}%
      \hss}%
    \vskip1.1ex}%
}

% --- Title slide (\maketitle makes a plain frame, without the footer) ---------
\renewcommand\maketitle{%
  \begin{frame}[plain,noframenumbering]
    \titlepage
  \end{frame}}

\newcommand*\uel@watermark{%
  \ifuel@watermark
    \begin{scope}[opacity=.1]
      \node[anchor=south east,inner sep=0] at
        ([xshift=.8cm,yshift=-1.2cm]current page.south east)
        {\uel@logo[height=.8\paperheight]{simbolo-branco}};
    \end{scope}
  \fi}

% Same composition as the light theme: an upper block (here Verde UEL, which
% stands out against the emerald page) with the title, and a lower strip on the
% page color with author and logos.
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \path let \p1=(current page.north west),\p2=(current page.south east) in
      coordinate (uel@split) at (\x1,{\y1-.6*(\y1-\y2)});
    \begin{scope}
      \clip (current page.north west) rectangle (current page.east |- uel@split);
      \fill[uelgreen] (current page.north west) rectangle (current page.east |- uel@split);
      \uel@watermark
    \end{scope}
    \node[anchor=west,inner sep=0,text width=.72\paperwidth,align=left] at
      ($(current page.north west)!.5!(uel@split)+(\uel@margin,0)$) {%
      \usebeamercolor[fg]{title}%
      {\usebeamerfont{title}\inserttitle\par}%
      \ifx\insertsubtitle\@empty\else
        \vskip1ex
        {\usebeamerfont{subtitle}\color{white}\insertsubtitle\par}%
      \fi
    };
    \node[anchor=north west,inner sep=0,text width=.5\paperwidth,align=left] at
      ([xshift=\uel@margin,yshift=-.6cm]uel@split) {%
      {\usebeamerfont{author}\usebeamercolor[fg]{title}\insertauthor\par}%
      \ifx\insertinstitute\@empty\else
        \vskip.5ex
        {\usebeamerfont{institute}\usebeamercolor[fg]{subtitle}\insertinstitute\par}%
      \fi
      \ifx\insertdate\@empty\else
        \vskip.5ex
        {\usebeamerfont{date}\usebeamercolor[fg]{subtitle}\insertdate\par}%
      \fi
    };
    \ifuel@dc
      \node[anchor=south east,inner sep=0] (uel@dcnode) at
        ([xshift=-\uel@margin,yshift=.6cm]current page.south east)
        {\uel@dclogo{1.3cm}};
      \node[anchor=east,inner sep=0] at ([xshift=-.7cm]uel@dcnode.west)
        {\uel@logo[height=.8cm]{horizontal-branca}};
    \else
      \node[anchor=south east,inner sep=0] at
        ([xshift=-\uel@margin,yshift=.6cm]current page.south east)
        {\uel@logo[height=.9cm]{horizontal-branca}};
    \fi
  \end{tikzpicture}%
}

% --- Section divider ---------------------------------------------------------
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[uelgreen] (current page.south west) rectangle (current page.north east);
    \begin{scope}
      \clip (current page.south west) rectangle (current page.north east);
      \ifuel@watermark
        \begin{scope}[opacity=.1]
          \node[anchor=south east,inner sep=0] at
            ([xshift=.8cm,yshift=-1.2cm]current page.south east)
            {\uel@logo[height=.8\paperheight]{simbolo-branco}};
        \end{scope}
      \fi
    \end{scope}
    \node[anchor=south east,inner sep=0] at
      ([xshift=-\uel@margin,yshift=\uel@margin]current page.south east)
      {\uel@logo[height=.8cm]{vertical-abreviada-branca}};
    \node[anchor=west,inner sep=0,text width=.72\paperwidth,align=left] at
      ([xshift=\uel@margin]current page.west) {%
      \usebeamercolor[fg]{section page}%
      {\usebeamerfont{section page}\insertsection\par}%
    };
  \end{tikzpicture}%
}
\ifuel@sectionpage
  \AtBeginSection[]{%
    \begin{frame}[plain,noframenumbering]
      \sectionpage
    \end{frame}}
\fi

% --- Table of contents ---------------------------------------------------------
\setbeamertemplate{section in toc}{%
  \leavevmode\color{uelgreenbright}\bfseries\inserttocsectionnumber.\ %
  \color{uelink}\inserttocsection\par}
\setbeamertemplate{subsection in toc}{%
  \leavevmode\leftskip=1.4em\color{uelmuted}\small\inserttocsubsection\par}

\mode<all>
